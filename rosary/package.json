{
  "name": "rosary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A mobile-first, installable Rosary prayer guide.",
  "scripts": {
    "dev": "python3 -m http.server 4173 -d dist",
    "build": "node scripts/build.mjs",
    "preview": "python3 -m http.server 4173 -d dist",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test tests/unit/*.test.mjs tests/integration/*.test.mjs",
    "test": "npm run test:unit",
    "validate:repo": "node scripts/validate-repository.mjs",
    "check": "npm run typecheck && npm run test:unit && npm run build && npm run validate:repo"
  },
  "engines": {"node": ">=20"}
}
